    "./checks": "./src/checks.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "LICENSE"
  ],
  "dependencies": {
    "@pbi-lineage-lenz/core": "1.1.0",
    "@pbi-lineage-lenz/export": "1.1.0",
    "@pbi-lineage-lenz/handoff": "1.1.0",
    "@pbi-lineage-lenz/viewer": "1.1.0"
  },
  "keywords": [
    "power-bi",
    "pbip",
    "pbir",
    "tmdl",
    "dax",
    "lineage",
    "data-lineage",
