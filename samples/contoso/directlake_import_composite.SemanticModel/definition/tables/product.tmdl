	column 'Margin Tier' = SWITCH ( TRUE (), DIVIDE ( 'product'[Price] - 'product'[Cost], 'product'[Price] ) >= 0.5, "High Margin", DIVIDE ( 'product'[Price] - 'product'[Cost], 'product'[Price] ) >= 0.3, "Mid Margin", "Low Margin" )
