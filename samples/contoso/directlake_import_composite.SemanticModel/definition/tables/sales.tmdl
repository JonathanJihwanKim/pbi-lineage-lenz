table sales
	lineageTag: c5563bcc-daf3-4732-9b32-c31905dd048f
	sourceLineageTag: [dbo].[sales]

	measure 'Sales Amount' = SUMX ( 'sales', 'sales'[Quantity] * 'sales'[NetPrice] )
		formatString: \$#,0
		lineageTag: a1111111-1111-4111-8111-111111111111

	measure 'Total Cost' = SUMX ( 'sales', 'sales'[Quantity] * 'sales'[UnitCost] )
		formatString: \$#,0
		lineageTag: a2222222-2222-4222-8222-222222222222

	measure 'Gross Margin' = [Sales Amount] - [Total Cost]
		formatString: \$#,0
		lineageTag: a3333333-3333-4333-8333-333333333333

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Sales Amount] )
		formatString: 0.0%
		lineageTag: a4444444-4444-4444-8444-444444444444

	measure 'Total Quantity' = SUM ( 'sales'[Quantity] )
		formatString: #,0
		lineageTag: a5555555-5555-4555-8555-555555555555

	measure 'Order Count' = DISTINCTCOUNT ( 'sales'[OrderKey] )
		formatString: #,0
		lineageTag: a6666666-6666-4666-8666-666666666666

